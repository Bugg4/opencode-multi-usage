{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-multi-usage",
  "version": "0.1.0",
  "description": "OpenCode sidebar plugin for Codex, OpenCode Go, and CommandCode usage",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bugg4/opencode-multi-usage.git"
  },
  "homepage": "https://github.com/Bugg4/opencode-multi-usage#readme",
  "bugs": {
    "url": "https://github.com/Bugg4/opencode-multi-usage/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "codex",
    "chatgpt",
    "opencode-go",
    "commandcode",
    "tui"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "demo.png"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json --emitDeclarationOnly && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --conditions=browser --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2 <3",
    "@opentui/solid": ">=0.5.10 <1",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    }
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.8"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.8",
    "@opentui/solid": "0.5.11",
    "@types/node": "^24.12.2",
    "esbuild-plugin-solid": "^0.6.0",
    "prettier": "^3.9.6",
    "solid-js": "1.9.12",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
